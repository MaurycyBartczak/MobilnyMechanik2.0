  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"No Fines"</Description>
      <Options moHideChildren="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(SelectFinesAOB,eurotrucks2.exe,48 8B C4 89 50 ?? 55 53 56 41 54 41 55 41 56 48 8D A8 ?? ?? ?? ?? 48 81 EC ?? ?? ?? ?? 48 8B F1) // should be unique
alloc(SelectableCancelableFines, $256)

label(code)
registerSymbol(SelFines)
label(return)

SelectableCancelableFines+$100:
SelFines:
db 0  // Crash
db 0  // Avoid Sleeping
db 0  // Wrong Way
db 0  // Speeding Camera
db 0  // No Lights
db 0  // Red Signal
db 0  // Speeding
db 0  // Avoid weighing
db 0  // Illegal Trailer
db 0  // Avoid Inspection
db 0  // Illegal Border Crossing
db 0  // Hard Shoulder Violation
db 0  // Damaged Vehicle Usage
db 0  // Illegal Trailer Weigh Station
db 0  // Generic

SelectableCancelableFines:
cmp edx, 14
jge GenericFine
mov rax, SelFines
add rax, edx
movzx eax, byte ptr [rax]
jmp FineCheck

GenericFine:
mov eax, [SelFines+14]
jmp FineCheck

FineCheck:
test eax, eax
je code
ret

code:
  readmem(SelectFinesAOB, 32)
  jmp return

SelFinesAOBOrig:
readmem(SelectFinesAOB, 32)
registerSymbol(SelFinesAOBOrig)

SelectFinesAOB:
  jmp far SelectableCancelableFines
  nop 12
return:
registersymbol(SelectFinesAOB)

[DISABLE]

SelectFinesAOB:
readmem(SelFinesAOBOrig, 32)

unregistersymbol(SelectFinesAOB)
unregisterSymbol(SelFines)
unregisterSymbol(SelFinesAOBOrig)
dealloc(SelectableCancelableFines)

