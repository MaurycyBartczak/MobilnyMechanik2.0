    <CheatEntry>
      <ID>49</ID>
      <Description>"Speedhack"</Description>
      <Options moHideChildren="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobScanModule(GetVelocityFncAOB, eurotrucks2.exe, 48 8B DA 48 85 C9 74 66 48 8B 49 18)
alloc(SpeedhackLogic, 128, GetVelocityFncAOB)

globalalloc(SpeedupHotkey, 4)

SpeedupHotkey:
db BC

SpeedhackLogic:
{$c}
#define EPSILON 0.00001f

float sqrtf(float);

typedef struct
{
    float x, y, z;
} Vector3;

typedef struct
{
    float x, y, z, w;
} Quaternion;

void quaternion_normalize(Quaternion* q)
{
    float magnitude = sqrtf(q-&gt;w*q-&gt;w + q-&gt;x*q-&gt;x + q-&gt;y*q-&gt;y + q-&gt;z*q-&gt;z);

    if (magnitude &gt; EPSILON) {
        q-&gt;w /= magnitude;
        q-&gt;x /= magnitude;
        q-&gt;y /= magnitude;
        q-&gt;z /= magnitude;
    } else {
        q-&gt;w = 1.0f;
        q-&gt;x = 0.0f;
        q-&gt;y = 0.0f;
        q-&gt;z = 0.0f;
    }
}

Quaternion quaternion_conjugate(Quaternion q)
{
    Quaternion result;
    result.w = q.w;
    result.x = -q.x;
    result.y = -q.y;
    result.z = -q.z;
    return result;
}

Quaternion quaternion_multiply(Quaternion q1, Quaternion q2)
{
    Quaternion result;

    result.w = q1.w * q2.w - q1.x * q2.x - q1.y * q2.y - q1.z * q2.z;
    result.x = q1.w * q2.x + q1.x * q2.w + q1.y * q2.z - q1.z * q2.y;
    result.y = q1.w * q2.y - q1.x * q2.z + q1.y * q2.w + q1.z * q2.x;
    result.z = q1.w * q2.z + q1.x * q2.y - q1.y * q2.x + q1.z * q2.w;

    return result;
}

Quaternion vector3_to_pure_quaternion(Vector3 v)
{
    Quaternion q_v;
    q_v.w = 0.0f;
    q_v.x = v.x;
    q_v.y = v.y;
    q_v.z = v.z;
    return q_v;
}

Vector3 pure_quaternion_to_vector3(Quaternion q_v)
{
    Vector3 v;
    v.x = q_v.x;
    v.y = q_v.y;
    v.z = q_v.z;
    return v;
}

Vector3 rotate_vector_by_quaternion(Vector3 v, Quaternion q)
{
    quaternion_normalize(&amp;q);

    Quaternion q_v = vector3_to_pure_quaternion(v);

    Quaternion q_inv = quaternion_conjugate(q);

    Quaternion temp = quaternion_multiply(q, q_v);
    Quaternion rotated_q_v = quaternion_multiply(temp, q_inv);

    return pure_quaternion_to_vector3(rotated_q_v);
}
{$asm}

{$ccode pBaseCtrl=RCX}
extern unsigned short GetAsyncKeyState(int vKey);

if (!pBaseCtrl)
    return;

unsigned long long pGamePhysVeh = *(unsigned long long*)(pBaseCtrl + 0x18);
if (!pGamePhysVeh)
    return;

unsigned long long physComponent = *(unsigned long long*)(pGamePhysVeh + 0x30);

if (!physComponent)
    return;

unsigned long long pxRigidDynamic = *(unsigned long long*)(physComponent + 0xD8);

if (!pxRigidDynamic)
    return;

Vector3 forward = {0.0f, 0.0f, -1.0f};
forward = rotate_vector_by_quaternion(forward, *(Quaternion*)(pxRigidDynamic + 0x90));

typedef enum
{
    eFORCE,
    eIMPULSE,
    eVELOCITY_CHANGE,
    eACCELERATION
} PxForceMode;

extern int SpeedupHotkey;

if (GetAsyncKeyState(SpeedupHotkey) &amp; 0x8000)
{
    extern float Force;

    void **vftable = *(void***)pxRigidDynamic;
    forward.x *= Force / 60.0f;
    forward.y *= Force / 60.0f;
    forward.z *= Force / 60.0f;
    ((void(__stdcall *)(void *, Vector3 *, PxForceMode, unsigned char))vftable[41])(pxRigidDynamic, &amp;forward, eFORCE, 1);
}
{$asm}

